# Lenra API server
PORT=4000
# Public base URL for OAuth callbacks, payment redirects, etc. (defaults to http://localhost:PORT)
API_PUBLIC_URL=http://localhost:4000

# Same MySQL database as Lenra (schema on lenra repo)
DATABASE_URL="mysql://lenra:lenra@127.0.0.1:3306/lenra"

# Must match Lenra AUTH_SECRET if the API validates session JWTs from the app
AUTH_SECRET=""

# Comma-separated browser origins allowed to call this API (Lenra frontend)
# Example: http://localhost:3001,https://lenra.ir
CORS_ORIGINS="http://localhost:3001"

# Optional: protect internal/cron routes
API_INTERNAL_SECRET=""

# Google OAuth (sign-in / account linking)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Phone OTP via Kavenegar — leave empty in dev to print the code in the console
# and surface it in the sign-in form. Fill in once you have an account.
# Paste exactly from Kavenegar panel → API Key (often a long hex string)
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_TEST_MODE=true
KAVENEGAR_OTP_TEMPLATE="otp-login"

DEEPGRAM_API_KEY=""
OPENAI_API_KEY=""
OPENSUBTITLES_API_KEY=""

# Object storage (S3-compatible, e.g. Arvan)
CLOUD_ENDPOINT=""
CLOUD_ACCESS_KEY=""
CLOUD_SECRET_KEY=""
CLOUD_BUCKET_NAME=""
MEDIA_BASE_URL=""
MEDIA_HLS_PREFIX=hls
MEDIA_COVERS_PREFIX=covers
AVATARS_PREFIX=avatars
NEXT_PUBLIC_MEDIA_BASE_URL=""
NEXT_PUBLIC_MEDIA_HLS_PREFIX=hls

REVALIDATE_SECRET=""

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=mailto:support@lenra.ir

# BitPay
BITPAY_API=""
BITPAY_REDIRECT_BASE_URL=https://lenra.ir
