{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "next/cache": ["./shim/next-cache.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "shim/**/*.ts"],
  "exclude": ["node_modules"]
}
